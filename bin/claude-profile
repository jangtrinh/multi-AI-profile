#!/usr/bin/env python3
import sys
import os
import shutil
import subprocess
import argparse
from pathlib import Path

COLOR_MAP = {
    "blue": (30, 100, 220, 240),
    "purple": (140, 50, 200, 240),
    "green": (22, 140, 85, 240),
    "emerald": (16, 140, 90, 240),
    "orange": (220, 100, 20, 240),
    "amber": (210, 115, 25, 240),
    "red": (205, 45, 60, 240),
    "pink": (215, 60, 140, 240),
    "cyan": (14, 130, 160, 240),
    "teal": (20, 130, 120, 240),
    "gray": (85, 85, 95, 240),
    "dark": (40, 40, 45, 245)
}

HOME = Path.home()
CLAUDE_ORIG = Path("/Applications/Claude.app")
APPLICATIONS = HOME / "Applications"
APP_SUPPORT = HOME / "Library" / "Application Support"

def generate_badged_icon(text, color_rgb, output_icns):
    try:
        from PIL import Image, ImageDraw, ImageFont
    except ImportError:
        print("[!] Pillow not found, falling back to original icon")
        shutil.copy(CLAUDE_ORIG / "Contents" / "Resources" / "electron.icns", output_icns)
        return

    tmp_dir = Path("/tmp/claude_profile_icon_build")
    tmp_dir.mkdir(parents=True, exist_ok=True)
    base_png = tmp_dir / "base.png"

    # Extract base PNG from Claude.app
    subprocess.run([
        "sips", "-s", "format", "png",
        str(CLAUDE_ORIG / "Contents" / "Resources" / "electron.icns"),
        "--out", str(base_png)
    ], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    base_img = Image.open(base_png).convert("RGBA")
    W, H = base_img.size

    # Pick system font
    font = None
    for fp in [
        "/System/Library/Fonts/SFPro-Bold.ttf",
        "/System/Library/Fonts/SFNS.ttf",
        "/System/Library/Fonts/HelveticaNeue.ttc",
        "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
        "/Library/Fonts/Arial Bold.ttf"
    ]:
        if os.path.exists(fp):
            try:
                # Scale font size based on text length
                size = 130 if len(text) <= 5 else max(80, 130 - (len(text) - 5) * 12)
                font = ImageFont.truetype(fp, size)
                break
            except Exception:
                pass
    if font is None:
        font = ImageFont.load_default()

    draw = ImageDraw.Draw(base_img)
    bbox = draw.textbbox((0, 0), text, font=font)
    tw = bbox[2] - bbox[0]
    th = bbox[3] - bbox[1]

    bw = tw + 90
    bh = th + 54
    bx = (W - bw) // 2
    by = H - bh - 70

    shadow_img = Image.new("RGBA", (W, H), (0, 0, 0, 0))
    s_draw = ImageDraw.Draw(shadow_img)
    s_draw.rounded_rectangle([bx - 6, by + 4, bx + bw + 6, by + bh + 14], radius=32, fill=(0, 0, 0, 160))
    base_img = Image.alpha_composite(base_img, shadow_img)

    draw = ImageDraw.Draw(base_img)
    draw.rounded_rectangle([bx, by, bx + bw, by + bh], radius=28, fill=color_rgb)
    draw.rounded_rectangle([bx, by, bx + bw, by + bh], radius=28, outline=(255, 255, 255, 220), width=6)

    tx = bx + (bw - tw) // 2 - bbox[0]
    ty = by + (bh - th) // 2 - bbox[1] - 4
    draw.text((tx, ty), text, font=font, fill=(255, 255, 255, 255))

    iconset_dir = tmp_dir / "icon.iconset"
    iconset_dir.mkdir(parents=True, exist_ok=True)
    sizes = [16, 32, 64, 128, 256, 512, 1024]
    for s in sizes:
        if s <= 512:
            resized = base_img.resize((s, s), Image.Resampling.LANCZOS)
            resized.save(iconset_dir / f"icon_{s}x{s}.png")
        if s >= 32:
            half = s // 2
            resized2x = base_img.resize((s, s), Image.Resampling.LANCZOS)
            resized2x.save(iconset_dir / f"icon_{half}x{half}@2x.png")

    subprocess.run(["iconutil", "-c", "icns", str(iconset_dir), "-o", str(output_icns)], check=True)
    shutil.rmtree(tmp_dir)

def create_profile(name, color_name="blue"):
    clean_name = name.strip()
    slug = clean_name.lower().replace(" ", "-")
    app_display_name = f"Claude {clean_name}"
    bundle_id = f"com.anthropic.claude.{slug}"
    target_app = APPLICATIONS / f"{app_display_name}.app"
    profile_data_dir = APP_SUPPORT / f"Claude-{clean_name.replace(' ', '-')}"
    config_file = profile_data_dir / "claude_desktop_config.json"

    if not CLAUDE_ORIG.exists():
        print(f"Error: Original Claude not found at {CLAUDE_ORIG}", file=sys.stderr)
        sys.exit(1)

    print(f"==> Setting up profile '{clean_name}'...")
    print(f"    App: {target_app}")
    print(f"    Data Dir: {profile_data_dir}")

    # 1. Create data dir & initial MCP config
    profile_data_dir.mkdir(parents=True, exist_ok=True)
    if not config_file.exists():
        config_file.write_text('{\n  "mcpServers": {}\n}\n')
        print(f"    Created MCP config: {config_file}")

    # 2. Clone base app using APFS clonefile (instant, zero disk overhead)
    if target_app.exists():
        print(f"    Removing existing app at {target_app}...")
        shutil.rmtree(target_app)
    
    subprocess.run(["cp", "-cR", str(CLAUDE_ORIG), str(target_app)], check=True)

    # 3. Rename helper apps in Contents/Frameworks
    frameworks_dir = target_app / "Contents" / "Frameworks"
    if frameworks_dir.exists():
        for f in frameworks_dir.glob("Claude Helper*.app"):
            new_f_name = f.name.replace("Claude", app_display_name)
            new_f = frameworks_dir / new_f_name
            f.rename(new_f)
            
            # Rename inner binary
            inner_macos = new_f / "Contents" / "MacOS"
            inner_old_bin = inner_macos / f.name
            inner_new_bin = inner_macos / new_f_name
            if inner_old_bin.exists():
                inner_old_bin.rename(inner_new_bin)
            else:
                for b in inner_macos.iterdir():
                    b.rename(inner_macos / new_f.stem)
                    break

            plist = new_f / "Contents" / "Info.plist"
            if plist.exists():
                for key in ["CFBundleDisplayName", "CFBundleName", "CFBundleExecutable"]:
                    subprocess.run(["/usr/libexec/PlistBuddy", "-c", f"Set :{key} '{new_f.stem}'", str(plist)], stderr=subprocess.DEVNULL)

    # 4. Configure main Info.plist
    main_plist = target_app / "Contents" / "Info.plist"
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", f"Set :CFBundleDisplayName '{app_display_name}'", str(main_plist)], check=True)
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", f"Set :CFBundleName '{app_display_name}'", str(main_plist)], check=True)
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", f"Set :CFBundleIdentifier '{bundle_id}'", str(main_plist)], check=True)
    subprocess.run(["/usr/libexec/PlistBuddy", "-c", "Delete :CFBundleIconName", str(main_plist)], stderr=subprocess.DEVNULL)

    # 5. Remove Assets.car so custom icon is forced
    assets_car = target_app / "Contents" / "Resources" / "Assets.car"
    if assets_car.exists():
        assets_car.unlink()

    # 6. Generate and install custom badged icon
    color_rgb = COLOR_MAP.get(color_name.lower(), COLOR_MAP["blue"])
    badge_label = clean_name.upper()
    target_icns = target_app / "Contents" / "Resources" / "electron.icns"
    generate_badged_icon(badge_label, color_rgb, target_icns)

    # 7. Compile native Mach-O launcher
    macos_dir = target_app / "Contents" / "MacOS"
    orig_bin = macos_dir / "Claude"
    real_bin = macos_dir / "Claude.real"
    orig_bin.rename(real_bin)

    c_source = f"""#include <unistd.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <libgen.h>
#include <limits.h>
#include <mach-o/dyld.h>

int main(int argc, char *argv[]) {{
    char path[PATH_MAX];
    uint32_t size = sizeof(path);
    if (_NSGetExecutablePath(path, &size) != 0) return 1;
    char *dir = dirname(path);
    char real_bin[PATH_MAX];
    snprintf(real_bin, sizeof(real_bin), "%s/Claude.real", dir);

    const char *home = getenv("HOME");
    char user_data[PATH_MAX];
    snprintf(user_data, sizeof(user_data), "--user-data-dir=%s/Library/Application Support/Claude-{clean_name.replace(' ', '-')}", home);

    char **new_argv = malloc((argc + 2) * sizeof(char *));
    new_argv[0] = real_bin;
    new_argv[1] = user_data;
    for (int i = 1; i < argc; i++) {{
        new_argv[i + 1] = argv[i];
    }}
    new_argv[argc + 1] = NULL;

    execv(real_bin, new_argv);
    return 0;
}}
"""
    tmp_c = Path(f"/tmp/launcher_{slug}.c")
    tmp_c.write_text(c_source)
    subprocess.run(["clang", "-O2", str(tmp_c), "-o", str(orig_bin)], check=True)
    orig_bin.chmod(0o755)
    real_bin.chmod(0o755)
    tmp_c.unlink(missing_ok=True)

    # 8. Re-sign bundle and register with macOS
    subprocess.run(["codesign", "--force", "--deep", "--sign", "-", str(target_app)], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister", "-f", "-r", str(target_app)], check=True)
    target_app.touch()

    print(f"\n[✓] Successfully created {app_display_name}.app!")
    print(f"    - Launch via: open '{target_app}' (or Spotlight / Dock)")
    print(f"    - MCP Config: {config_file}\n")

def list_profiles():
    print("=== Claude Profiles ===")
    print("0. Claude (Default)")
    print("   - App: /Applications/Claude.app")
    print(f"   - MCP Config: {APP_SUPPORT}/Claude/claude_desktop_config.json")
    
    idx = 1
    for app in sorted(APPLICATIONS.glob("Claude *.app")):
        if app.stem == "Claude":
            continue
        name = app.stem.replace("Claude ", "")
        data_dir = APP_SUPPORT / f"Claude-{name.replace(' ', '-')}"
        cfg = data_dir / "claude_desktop_config.json"
        print(f"\n{idx}. {app.stem}")
        print(f"   - App: {app}")
        print(f"   - Data Dir: {data_dir}")
        print(f"   - MCP Config: {cfg if cfg.exists() else 'Not initialized'}")
        idx += 1

def delete_profile(name):
    clean_name = name.strip()
    app_display_name = f"Claude {clean_name}"
    target_app = APPLICATIONS / f"{app_display_name}.app"
    profile_data_dir = APP_SUPPORT / f"Claude-{clean_name.replace(' ', '-')}"

    if target_app.exists():
        shutil.rmtree(target_app)
        print(f"[✓] Deleted app: {target_app}")
    else:
        print(f"[!] App not found: {target_app}")

    if profile_data_dir.exists():
        print(f"[*] Note: Profile data directory was PRESERVED at:\n    {profile_data_dir}")
        print("    (Delete manually if you wish to remove account credentials and cache).")

def main():
    parser = argparse.ArgumentParser(description="Manage isolated Claude Desktop instances with custom names & badged icons.")
    subparsers = parser.add_subparsers(dest="command")

    # Create command
    create_parser = subparsers.add_parser("create", help="Create a new Claude profile app")
    create_parser.add_argument("name", help="Profile name (e.g. Work, Extra, Personal, Test)")
    create_parser.add_argument("--color", default="blue", choices=list(COLOR_MAP.keys()), help=f"Badge color (default: blue). Choices: {', '.join(COLOR_MAP.keys())}")

    # List command
    subparsers.add_parser("list", help="List all installed Claude profiles")

    # Delete command
    del_parser = subparsers.add_parser("delete", help="Delete a Claude profile app")
    del_parser.add_argument("name", help="Profile name to remove")

    args = parser.parse_args()

    if args.command == "create":
        create_profile(args.name, args.color)
    elif args.command == "list":
        list_profiles()
    elif args.command == "delete":
        delete_profile(args.name)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
